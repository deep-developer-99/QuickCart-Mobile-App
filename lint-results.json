h(() => {});\n  return next;\n};\n\nexport const readLocalCart = async (userId: string): Promise<CartItem[]> => {\n  if (deactivated.has(userId)) return [];\n  const raw = await AsyncStorage.getItem(cartStorageKey(userId));\n  if (!raw || deactivated.has(userId)) return [];\n  try {\n    const value = JSON.parse(raw) as { version?: number; userId?: string; items?: CartItem[] };\n    if (value.version !== CART_VERSION || value.userId !== userId || !Array.isArray(value.items)) return [];\n    return value.items;\n  } catch { return []; }\n};\n\nexport const writeLocalCart = (userId: string, items: CartItem[]) =>\n  queueWrite(userId, async () => {\n    if (deactivated.has(userId)) return;\n    await AsyncStorage.setItem(cartStorageKey(userId), JSON.stringify({ version: CART_VERSION, userId, items }));\n  });\n\nexport const deactivateLocalCart = (userId: string) => {\n  deactivated.add(userId);\n  return queueWrite(userId, () => AsyncStorage.removeItem(cartStorageKey(userId)));\n};\r\n","usedDeprecatedRules":[{"ruleId":"no-negated-in-lhs","replacedBy":["no-unsafe-negation"]},{"ruleId":"no-catch-shadow","replacedBy":["no-shadow"]},{"ruleId":"handle-callback-err","replacedBy":[]},{"ruleId":"no-mixed-requires","replacedBy":[]},{"ruleId":"no-new-require","replacedBy":[]},{"ruleId":"no-path-concat","replacedBy":[]},{"ruleId":"no-restricted-modules","replacedBy":[]},{"ruleId":"no-new-object","replacedBy":["no-object-constructor"]}]},{"filePath":"D:\\QuickCart-Mobile\\src\\services\\cashfreePaymentService.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-negated-in-lhs","replacedBy":["no-unsafe-negation"]},{"ruleId":"no-catch-shadow","replacedBy":["no-shadow"]},{"ruleId":"handle-callback-err","replacedBy":[]},{"ruleId":"no-mixed-requires","replacedBy":[]},{"ruleId":"no-new-require","replacedBy":[]},{"ruleId":"no-path-concat","replacedBy":[]},{"ruleId