t React, { useState } from 'react';\r\nimport { useTranslation } from 'react-i18next';\r\nimport {\r\n  ActivityIndicator,\r\n  Alert,\r\n  Image,\r\n  Pressable,\r\n  ScrollView,\r\n  StyleSheet,\r\n  View,\r\n} from 'react-native';\r\nimport { SafeAreaView } from 'react-native-safe-area-context';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport type { NativeStackScreenProps } from '@react-navigation/native-stack';\r\n\r\nimport {\r\n  type Address,\r\n  useGetAddressesQuery,\r\n} from '../../api/addressApi';\r\nimport AddAddressModal from '../../components/AddAddressModal';\r\nimport BackButton from '../../components/common/BackButton';\r\nimport {\r\n  useCreateOrderMutation,\r\n  useGetCheckoutSummaryMutation,\r\n} from '../../api/orderApi';\r\nimport {\r\n  useCreateCashfreeSessionMutation,\r\n  useVerifyCashfreePaymentMutation,\r\n} from '../../api/cashfreePaymentApi';\r\nimport { startCashfreeTransaction } from '../../services/cashfreePaymentService';\r\nimport type { CartItem } from '../../api/quickCartApi';\r\nimport type { RootState, AppDispatch } from '../../store/store';\r\nimport { removePurchasedCartLines } from '../../store/slices/cartSlice';\r\nimport { hasVariantDiscount, variantDiscountPercentage, variantSellingPrice } from '../../utils/variantPricing';\r\nimport type { RootStackParamList } from '../../navigation/RootNavigator';\r\nimport { useTheme } from '../../theme';\r\nimport type { ThemeColors } from '../../theme';\r\nimport OrderSuccessIllustration from '../../assets/checkout/order-success.svg';\r\n\r\ntype Props = NativeStackScreenProps<RootStackParamList, 'Checkout'>;\r\n\r\ntype Step = 'shipping' | 'payment' | 'review' | 'success';\r\ntype PaymentMethod =\r\n  | 'COD'\r\n  | 'UPI_GPAY'\r\n  | 'UPI_PHONEPE'\r\n  | 'UPI_PAYTM'\r\n  | 'UPI_OTHER'\r\n  | 'CARD'\r\n  | 'WALLET';\r\n\r\nexport default function CheckoutScreen({ navigation }: Props) {\r\n  const { t } = useTranslation();\r\n  const styles = useStyles();\r\n  const dispatch = useDispatch<AppDispatch>();\r\n  const userId = useSelector((state: RootState) => state.auth.user?.id ?? '');\r\n  const { items, hydratedForUserId } = useSelector((state: RootState) => state.cart);\r\n  const cartLoading = Boolean(userId && hydratedForUserId !== userId);\r\n  const { data: addressResponse, isLoading: addressLoading, refetch: refetchAddresses } =\r\n    useGetAddressesQuery();\r\n  const [createOrder, { isLoading: placingCartOrder }] =\r\n    useCreateOrderMutation();\r\n  const [getCheckoutSummary, { isLoading: verifyingCart }] = useGetCheckoutSummaryMutation();\r\n  const [createCashfreeSession, { isLoading: creatingCashfreeSession }] =\r\n    useCreateCashfreeSessionMutation();\r\n  const [verifyCashfreePayment, { isLoading: verifyingCashfreePayment }] =\r\n    useVerifyCashfreePaymentMutation();\r\n\r\n  const cartLines = items.flatMap(item => item.product?._id && item.variantId ? [{ productId: item.product._id, variantId: item.variantId, quantity: item.quantity }] : []);\r\n  const cartLinesKey = JSON.stringify(cartLines);\r\n  const [verifiedSummary, setVerifiedSummary] = useState<{ success: boolean; data: { subtotal: number; shippingAmount: number; totalAmount: number; items: Array<{ productId: string; variantId: string; sellingPrice: number; name: string }> } } | null>(null);\r\n  const [priceChangesAccepted, setPriceChangesAccepted] = useState(false);\r\n  const [checkoutValidationError, setCheckoutValidationError] = useState('');\r\n  React.useEffect(() => {\r\n    if (!userId || cartLoading || cartLines.length === 0) { setVerifiedSummary(null); return; }\r\n    setCheckoutValidationError('');\r\n    getCheckoutSummary({ items: cartLines }).unwrap()\r\n      .then(summary => { setVerifiedSummary(summary); setPriceChangesAccepted(false); setCheckoutValidationError(''); })\r\n      .catch(error => {\r\n        console.warn('Checkout cart validation failed:', error);\r\n        setVerifiedSummary(null);\r\n        setCheckoutValidationError(error?.data?.message ?? 'Unable to verify current prices and stock. Check your connection and try again.');\r\n      });\r\n  // cartLinesKey represents the stable line identifiers and quantities.\r\n  // eslint-disable-next-line react-hooks/exhaustive-deps\r\n  }, [cartLinesKey, cartLoading, getCheckoutSummary, userId]);\r\n\r\n  const addresses: Address[] = addressResponse?.data ?? [];\r\n  const placingOrder =\r\n    placingCartOrder ||\r\n    verifyingCart ||\r\n    creatingCashfreeSession ||\r\n    verifyingCashfreePayment;\r\n\r\n  const [step, setStep] = useState<Step>('shipping');\r\n  const [addressId, setAddressId] = useState('');\r\n  const [payment, setPayment] = useState<PaymentMethod>('COD');\r\n  const isOnlinePayment = payment !== 'COD';\r\n\r\n  const [addressModalOpen, setAddressModalOpen] = useState(false);\r\n\r\n  const localSubtotal = items.reduce((sum, item) => {\r\n    const price = variantSellingPrice(item.product.variants?.find(variant => variant._id === item.variantId));\r\n    return sum + price * item.quantity;\r\n  }, 0);\r\n\r\n  const subtotal = verifiedSummary?.data.subtotal ?? localSubtotal;\r\n  const shipping = verifiedSummary?.data.shippingAmount ?? (localSubtotal > 0 && localSubtotal <= 99 ? 40 : 0);\r\n  const total = verifiedSummary?.data.totalAmount ?? subtotal + shipping;\r\n  const changedPrices = (verifiedSummary?.data.items ?? []).filter(verified => {\r\n    const local = items.find(item => item.product._id === verified.productId && item.variantId === verified.variantId);\r\n    const localPrice = local ? variantSellingPrice(local.product.variants?.find(variant => variant._id === local.variantId)) : 0;\r\n    return Math.abs(localPrice - verified.sellingPrice) > 0.009;\r\n  });\r\n  const hasUnacceptedPriceChanges = changedPrices.length > 0 && !priceChangesAccepted;\r\n\r\n  const selectedAddress = addresses.find(address => address._id === addressId);\r\n\r\n  const selectAddress = (address: Address) => {\r\n    setAddressId(address._id);\r\n    setStep('payment');\r\n  };\r\n\r\n  const placeOrder = async () => {\r\n    if (!addressId) {\r\n      Alert.alert(\r\n        t('ui.checkout.selectAddress'),\r\n        t('ui.checkout.selectAddressMessage'),\r\n      );\r\n      return;\r\n    }\r\n\r\n    if (items.length === 0) {\r\n      Alert.alert(\r\n        t('ui.checkout.emptyCart'),\r\n        t('ui.checkout.emptyCartMessage'),\r\n      );\r\n      return;\r\n    }\r\n    if (!verifiedSummary) {\r\n      Alert.alert(t('ui.checkout.paymentStatusUnavailable'), 'Current prices and stock are still being checked. Please try again.');\r\n      return;\r\n    }\r\n    if (hasUnacceptedPriceChanges) {\r\n      Alert.alert(t('ui.checkout.reviewOrder'), 'Review and accept the updated item prices before continuing.');\r\n      return;\r\n    }\r\n\r\n    try {\r\n      if (isOnlinePayment) {\r\n        const session = await createCashfreeSession({\r\n          addressId,\r\n          checkoutMode: 'cart',\r\n          paymentMethod: payment as Exclude<PaymentMethod, 'COD'>,\r\n          items: cartLines,\r\n          expectedTotal: verifiedSummary.data.totalAmount,\r\n        }).unwrap();\r\n\r\n        // Cashfree's SDK callback is not proof of payment. Always verify with our backend.\r\n        try {\r\n          await startCashfreeTransaction(session.data);\r\n        } catch (sdkError) {\r\n          // The app can return an error even when the provider transaction is\r\n          // still processing. Check the server status before deciding.\r\n          console.warn(\r\n            'Cashfree SDK returned without a confirmed result:',\r\n            sdkError,\r\n          );\r\n        }\r\n\r\n        const verification = await verifyCashfreePayment({\r\n          paymentId: session.data.paymentId,\r\n        }).unwrap();\r\n\r\n        if (verification.data.status === 'paid') {\r\n          dispatch(removePurchasedCartLines({ userId, items: cartLines }));\r\n          setStep('success');\r\n          return;\r\n        }\r\n\r\n        if (verification.data.status === 'paid_needs_review') {\r\n          Alert.alert(\r\n            t('ui.checkout.paymentReceived'),\r\n            t('ui.checkout.paymentReview'),\r\n          );\r\n          return;\r\n        }\r\n\r\n        if (verification.data.status === 'pending') {\r\n          Alert.alert(\r\n            t('ui.checkout.paymentProcessing'),\r\n            t('ui.checkout.paymentPending'),\r\n          );\r\n          return;\r\n        }\r\n\r\n        Alert.alert(\r\n          t('ui.checkout.paymentNotCompleted'),\r\n          t('ui.checkout.paymentNotConfirmed'),\r\n        );\r\n        return;\r\n      }\r\n\r\n      await createOrder({ addressId, paymentMethod: 'COD', items: cartLines, expectedTotal: verifiedSummary.data.totalAmount }).unwrap();\r\n      dispatch(removePurchasedCartLines({ userId, items: cartLines }));\r\n\r\n      setStep('success');\r\n    } catch (error: any) {\r\n      if (error?.status === 409) {\r\n        try {\r\n          const summary = await getCheckoutSummary({ items: cartLines }).unwrap();\r\n          setVerifiedSummary(summary);\r\n          setPriceChangesAccepted(false);\r\n          setCheckoutValidationError('');\r\n        } catch (refreshError) { console.warn('Unable to refresh checkout totals:', refreshError); }\r\n      }\r\n      Alert.alert(\r\n        isOnlinePayment ? t('ui.checkout.paymentStatusUnavailable') : t('ui.checkout.orderFailed'),\r\n        error?.data?.message ??\r\n          (isOnlinePayment\r\n            ? t('ui.checkout.paymentCheckAgain')\r\n            : t('ui.checkout.unableToPlaceOrder')),\r\n      );\r\n    }\r\n  };\r\n\r\n  const goBack = () => {\r\n    if (step === 'shipping') {\r\n      navigation.goBack();\r\n      return;\r\n    }\r\n\r\n    if (step === 'payment') {\r\n      setStep('shipping');\r\n      return;\r\n    }\r\n\r\n    if (step === 'review') {\r\n      setStep('payment');\r\n    }\r\n  };\r\n\r\n  if (cartLoading || addressLoading || (items.length > 0 && verifyingCart && !verifiedSummary)) {\r\n    return (\r\n      <SafeAreaView style={styles.container}>\r\n        <View style={styles.center}>\r\n          <ActivityIndicator size=\"large\" />\r\n          <Text style={styles.muted}>{t('ui.checkout.loading')}</Text>\r\n        </View>\r\n      </SafeAreaView>\r\n    );\r\n  }\r\n\r\n  if (step === 'success') {\r\n    return (\r\n      <SafeAreaView style={styles.container} edges={['top', 'bottom']}>\r\n        <ScrollView\r\n          contentContainerStyle={styles.success}\r\n          showsVerticalScrollIndicator={false}\r\n          bounces={false}\r\n        >\r\n          <View style={styles.successIllustrationContainer}>\r\n            <View style={styles.successArtwork}>\r\n              <OrderSuccessIllustration\r\n                width=\"100%\"\r\n                height=\"100%\"\r\n                style={styles.successIllustration}\r\n                accessible\r\n                accessibilityRole=\"image\"\r\n                accessibilityLabel={t('ui.checkout.successIllustrationAlt')}\r\n              />\r\n            </View>\r\n          </View>\r\n\r\n          <Text style={styles.successTitle}>\r\n            {t('ui.checkout.successTitle')}\r\n          </Text>\r\n\r\n          <Text style={styles.successText}>\r\n            {t('ui.checkout.successMessage')}\r\n          </Text>\r\n\r\n          <Pressable\r\n            style={styles.successButton}\r\n            onPress={() =>\r\n              navigation.replace('MainTabs', { screen: 'Categories' })\r\n            }\r\n            accessibilityRole=\"button\"\r\n          >\r\n            <Text style={styles.successButtonText}>\r\n              {t('ui.checkout.continueShopping')}\r\n            </Text>\r\n          </Pressable>\r\n        </ScrollView>\r\n      </SafeAreaView>\r\n    );\r\n  }\r\n\r\n  const currentStep = step === 'shipping' ? 0 : step === 'payment' ? 1 : 2;\r\n\r\n  return (\r\n    <SafeAreaView style={styles.container} edges={['top', 'bottom']}>\r\n        <Header title={t('ui.checkout.title')} onBack={goBack} />\r\n\r\n      <Steps\r\n        current={currentStep}\r\n        onPress={index => {\r\n          if (index === 0) {\r\n            setStep('shipping');\r\n          } else if (index === 1 && addressId) {\r\n            setStep('payment');\r\n          } else if (index === 2 && addressId) {\r\n            setStep('review');\r\n          }\r\n        }}\r\n      />\r\n\r\n      <ScrollView\r\n        showsVerticalScrollIndicator={false}\r\n        contentContainerStyle={styles.content}\r\n      >\r\n        {step === 'shipping' && (\r\n          <>\r\n            <SectionTitle title={t('ui.checkout.shippingAddress')} />\r\n\r\n            {addresses.map(address => (\r\n              <AddressCard\r\n                key={address._id}\r\n                address={address}\r\n                selected={addressId === address._id}\r\n                onPress={() => selectAddress(address)}\r\n              />\r\n            ))}\r\n            <Button\r\n              title={t('ui.checkout.addNewAddress')}\r\n              onPress={() => setAddressModalOpen(true)}\r\n            />\r\n          </>\r\n        )}\r\n\r\n        {step === 'payment' && (\r\n          <>\r\n            <SectionTitle title={t('ui.checkout.payment')} />\r\n\r\n            <View style={styles.paymentSection}>\r\n              <Text style={styles.paymentGroupTitle}>{t('ui.checkout.upi')}</Text>\r\n              <Text style={styles.paymentGroupSubtitle}>\r\n                {t('ui.checkout.chooseUpi')}\r\n              </Text>\r\n\r\n              <View style={styles.upiGrid}>\r\n                <UpiAppCard\r\n                  title=\"Google Pay\"\r\n                  shortLabel=\"G\"\r\n                  selected={payment === 'UPI_GPAY'}\r\n                  onPress={() => setPayment('UPI_GPAY')}\r\n                  color=\"#4285F4\"\r\n                />\r\n                <UpiAppCard\r\n                  title=\"PhonePe\"\r\n                  shortLabel=\"पे\"\r\n                  selected={payment === 'UPI_PHONEPE'}\r\n                  onPress={() => setPayment('UPI_PHONEPE')}\r\n                  color=\"#5F259F\"\r\n                />\r\n                <UpiAppCard\r\n                  title=\"Paytm\"\r\n                  shortLabel=\"P\"\r\n                  selected={payment === 'UPI_PAYTM'}\r\n                  onPress={() => setPayment('UPI_PAYTM')}\r\n                  color=\"#00A5E5\"\r\n                />\r\n              </View>\r\n\r\n              <MethodRow\r\n                title={t('ui.checkout.payOtherUpi')}\r\n                subtitle={t('ui.checkout.secureUpi')}\r\n                icon=\"↗\"\r\n                selected={payment === 'UPI_OTHER'}\r\n                onPress={() => setPayment('UPI_OTHER')}\r\n              />\r\n            </View>\r\n\r\n            <View style={styles.paymentSection}>\r\n              <Text style={styles.paymentGroupTitle}>\r\n                {t('ui.checkout.otherMethods')}\r\n              </Text>\r\n              <MethodRow\r\n                title={t('ui.checkout.cards')}\r\n                subtitle={t('ui.checkout.supportedCards')}\r\n                icon=\"▤\"\r\n                selected={payment === 'CARD'}\r\n                onPress={() => setPayment('CARD')}\r\n              />\r\n              <MethodRow\r\n                title={t('ui.checkout.wallet')}\r\n                subtitle={t('ui.checkout.supportedWallet')}\r\n                icon=\"▣\"\r\n                selected={payment === 'WALLET'}\r\n                onPress={() => setPayment('WALLET')}\r\n              />\r\n              <MethodRow\r\n                title={t('ui.checkout.cashOnDelivery')}\r\n                subtitle={t('ui.checkout.payWhenArrives')}\r\n                icon=\"₹\"\r\n                selected={payment === 'COD'}\r\n                onPress={() => setPayment('COD')}\r\n              />\r\n            </View>\r\n\r\n            {isOnlinePayment && (\r\n              <Text style={styles.paymentNotice}>{t('ui.checkout.onlineNotice')}</Text>\r\n            )}\r\n\r\n            {checkoutValidationError ? <Text style={styles.paymentNotice}>{checkoutValidationError}</Text> : null}\r\n\r\n            <Summary\r\n              items={items}\r\n              subtotal={subtotal}\r\n              shipping={shipping}\r\n              total={total}\r\n              verifiedItems={verifiedSummary?.data.items}\r\n            />\r\n\r\n            {checkoutValidationError ? <Text style={styles.paymentNotice}>{checkoutValidationError}</Text> : null}\r\n\r\n            <Button title={t('ui.checkout.continue')} onPress={() => setStep('review')} />\r\n          </>\r\n        )}\r\n\r\n        {step === 'review' && (\r\n          <>\r\n            <SectionTitle title={t('ui.checkout.reviewOrder')} />\r\n\r\n            <View style={styles.reviewCard}>\r\n              <Text style={styles.reviewLabel}>{t('ui.checkout.shippingAddress')}</Text>\r\n\r\n              {selectedAddress ? (\r\n                <>\r\n                  <Text style={styles.reviewValue}>\r\n                    {selectedAddress.fullName}\r\n                  </Text>\r\n                  <Text style={styles.reviewText}>{selectedAddress.phone}</Text>\r\n                  <Text style={styles.reviewText}>\r\n                    {selectedAddress.addressLine}\r\n                  </Text>\r\n                  <Text style={styles.reviewText}>\r\n                    {selectedAddress.city}, {selectedAddress.state} -{' '}\r\n                    {selectedAddress.pincode}\r\n                  </Text>\r\n                </>\r\n              ) : (\r\n                <Text style={styles.muted}>{t('ui.checkout.noAddress')}</Text>\r\n              )}\r\n            </View>\r\n\r\n            <Summary\r\n              items={items}\r\n              subtotal={subtotal}\r\n              shipping={shipping}\r\n              total={total}\r\n              verifiedItems={verifiedSummary?.data.items}\r\n            />\r\n\r\n            {changedPrices.length > 0 && (\r\n              <View style={styles.reviewCard}>\r\n                <Text style={styles.reviewLabel}>Some item prices changed</Text>\r\n                {changedPrices.map(item => {\r\n                  const local = items.find(entry => entry.product._id === item.productId && entry.variantId === item.variantId);\r\n                  const oldPrice = local ? variantSellingPrice(local.product.variants?.find(entry => entry._id === item.variantId)) : 0;\r\n                  return <Text key={`${item.productId}:${item.variantId}`} style={styles.reviewText}>{item.name}: ₹{oldPrice.toFixed(2)} → ₹{item.sellingPrice.toFixed(2)}</Text>;\r\n                })}\r\n                {!priceChangesAccepted ? (\r\n                  <Button title=\"Review and accept updated prices\" onPress={() => setPriceChangesAccepted(true)} />\r\n                ) : <Text style={styles.reviewText}>Updated prices accepted.</Text>}\r\n              </View>\r\n            )}\r\n\r\n            <Button\r\n              title={\r\n                placingOrder\r\n                  ? isOnlinePayment\r\n                    ? t('ui.checkout.processingPayment')\r\n                    : t('ui.checkout.placingOrder')\r\n                  : isOnlinePayment\r\n                  ? t('ui.checkout.payAmount', { amount: total.toFixed(2) })\r\n                  : t('ui.checkout.placeOrder')\r\n              }\r\n              disabled={placingOrder || !verifiedSummary || hasUnacceptedPriceChanges}\r\n              onPress={placeOrder}\r\n            />\r\n          </>\r\n        )}\r\n      </ScrollView>\r\n\r\n      <AddAddressModal\r\n        visible={addressModalOpen}\r\n        hasExistingAddresses={addresses.length > 0}\r\n        onClose={() => setAddressModalOpen(false)}\r\n        onSaved={async address => {\r\n          const refreshed = await refetchAddresses();\r\n          const savedAddress = refreshed.data?.data.find(\r\n            item => item._id === address._id,\r\n          );\r\n          setAddressId(savedAddress?._id ?? address._id);\r\n          setStep('payment');\r\n        }}\r\n      />\r\n    </SafeAreaView>\r\n  );\r\n}\r\n\r\nfunction Header({ title, onBack }: { title: string; onBack: () => void }) {\r\n  const styles = useStyles();\r\n  return (\r\n    <View style={styles.header}>\r\n      <BackButton onPress={onBack} style={styles.back} />\r\n      <Text style={styles.headerTitle}>{title}</Text>\r\n      <View style={styles.headerSpacer} />\r\n    </View>\r\n  );\r\n}\r\n\r\nfunction Steps({\r\n  current,\r\n  onPress,\r\n}: {\r\n  current: number;\r\n  onPress: (index: number) => void;\r\n}) {\r\n  const { t } = useTranslation();\r\n  const styles = useStyles();\r\n  const labels = [t('ui.checkout.shippingAddress'), t('ui.checkout.payment'), t('ui.checkout.reviewOrder')];\r\n\r\n  return (\r\n    <View style={styles.steps}>\r\n      {labels.map((label, index) => (\r\n        <React.Fragment key={label}>\r\n          <Pressable onPress={() => onPress(index)} style={styles.step}>\r\n            <View\r\n              style={[\r\n                styles.circle,\r\n                index === current && styles.circleCurrent,\r\n                index < current && styles.circleDone,\r\n              ]}\r\n            >\r\n              <Text\r\n                style={[\r\n                  styles.circleText,\r\n                  index <= current && styles.circleTextActive,\r\n                ]}\r\n              >\r\n                {index < current ? '✓' : index + 1}\r\n              </Text>\r\n            </View>\r\n\r\n            <Text\r\n              style={[\r\n                styles.stepLabel,\r\n                index === current && styles.currentLabel,\r\n                index < current && styles.doneLabel,\r\n              ]}\r\n            >\r\n              {label}\r\n            </Text>\r\n          </Pressable>\r\n\r\n          {index < labels.length - 1 && (\r\n            <View style={[styles.line, index < current && styles.doneLine]} />\r\n          )}\r\n        </React.Fragment>\r\n      ))}\r\n    </View>\r\n  );\r\n}\r\n\r\nfunction SectionTitle({ title }: { title: string }) {\r\n  const styles = useStyles();\r\n  return <Text style={styles.sectionTitle}>{title}</Text>;\r\n}\r\n\r\nfunction AddressCard({\r\n  address,\r\n  selected,\r\n  onPress,\r\n}: {\r\n  address: Address;\r\n  selected: boolean;\r\n  onPress: () => void;\r\n}) {\r\n  const styles = useStyles();\r\n  return (\r\n    <Pressable\r\n      onPress={onPress}\r\n      style={[styles.address, selected && styles.addressSelected]}\r\n    >\r\n      <View style={styles.radio}>\r\n        {selected && <View style={styles.radioInner} />}\r\n      </View>\r\n\r\n      <View style={styles.addressContent}>\r\n        <Text style={styles.addressName}>{address.fullName}</Text>\r\n        <Text style={styles.addressText}>{address.phone}</Text>\r\n        <Text style={styles.addressText}>\r\n          {address.addressLine}, {address.city}\r\n        </Text>\r\n        <Text style={styles.addressText}>\r\n          {address.state} - {address.pincode}\r\n        </Text>\r\n      </View>\r\n    </Pressable>\r\n  );\r\n}\r\n\r\nfunction UpiAppCard({\r\n  title,\r\n  shortLabel,\r\n  selected,\r\n  onPress,\r\n  color,\r\n}: {\r\n  title: string;\r\n  shortLabel: string;\r\n  selected: boolean;\r\n  onPress: () => void;\r\n  color: string;\r\n}) {\r\n  const styles = useStyles();\r\n  return (\r\n    <Pressable\r\n      accessibilityRole=\"button\"\r\n      accessibilityState={{ selected }}\r\n      onPress={onPress}\r\n      style={[styles.upiAppCard, selected && styles.paymentSelected]}\r\n    >\r\n      <View style={[styles.upiAppIcon, { backgroundColor: color }]}>\r\n        <Text style={styles.upiAppIconText}>{shortLabel}</Text>\r\n      </View>\r\n      <Text numberOfLines={1} style={styles.upiAppTitle}>\r\n        {title}\r\n      </Text>\r\n      <View style={[styles.smallRadio, selected && styles.smallRadioSelected]}>\r\n        {selected && <View style={styles.smallRadioInner} />}\r\n      </View>\r\n    </Pressable>\r\n  );\r\n}\r\n\r\nfunction MethodRow({\r\n  title,\r\n  subtitle,\r\n  icon,\r\n  selected,\r\n  onPress,\r\n}: {\r\n  title: string;\r\n  subtitle: string;\r\n  icon: string;\r\n  selected: boolean;\r\n  onPress: () => void;\r\n}) {\r\n  const styles = useStyles();\r\n  return (\r\n    <Pressable\r\n      accessibilityRole=\"button\"\r\n      accessibilityState={{ selected }}\r\n      onPress={onPress}\r\n      style={[styles.methodRow, selected && styles.paymentSelected]}\r\n    >\r\n      <View style={styles.methodIcon}>\r\n        <Text style={styles.methodIconText}>{icon}</Text>\r\n      </View>\r\n      <View style={styles.paymentText}>\r\n        <Text style={styles.paymentTitle}>{title}</Text>\r\n        <Text style={styles.paymentSub}>{subtitle}</Text>\r\n      </View>\r\n      <View style={styles.radio}>\r\n        {selected && <View style={styles.radioInner} />}\r\n      </View>\r\n    </Pressable>\r\n  );\r\n}\r\n\r\nfunction Summary({\r\n  items,\r\n  subtotal,\r\n  shipping,\r\n  total,\r\n  verifiedItems,\r\n}: {\r\n  items: CartItem[];\r\n  subtotal: number;\r\n  shipping: number;\r\n  total: number;\r\n  verifiedItems?: Array<{ productId: string; variantId: string; sellingPrice: number }>;\r\n}) {\r\n  const { t } = useTranslation();\r\n  const styles = useStyles();\r\n  const originalSubtotal = items.reduce(\r\n    (sum, item) => sum + (item.product.variants?.find(variant => variant._id === item.variantId)?.price ?? 0) * item.quantity,\r\n    0,\r\n  );\r\n  const discount = Math.max(0, originalSubtotal - subtotal);\r\n\r\n  return (\r\n    <View style={styles.summary}>\r\n      <Text style={styles.summaryTitle}>{t('ui.checkout.orderInfo')}</Text>\r\n\r\n      {items.length > 0 ? (\r\n        <View style={styles.orderItems}>\r\n          {items.map(item => {\r\n            const variant = item.product.variants?.find(entry => entry._id === item.variantId);\r\n            const unitPrice = verifiedItems?.find(entry => entry.productId === item.product._id && entry.variantId === item.variantId)?.sellingPrice ?? variantSellingPrice(variant);\r\n            const itemTotal = unitPrice * item.quantity;\r\n            const imageUri = item.product.image || item.product.images?.[0];\r\n\r\n            return (\r\n              <View key={`${item.product._id}:${item.variantId ?? ''}`} style={styles.orderItem}>\r\n                <View style={styles.orderItemImageBox}>\r\n                  {imageUri ? (\r\n                    <Image\r\n                      source={{ uri: imageUri }}\r\n                      style={styles.orderItemImage}\r\n                      accessibilityLabel={`${item.product.name} thumbnail`}\r\n                    />\r\n                  ) : (\r\n                    <Text style={styles.orderItemPlaceholder}>🛍️</Text>\r\n                  )}\r\n                </View>\r\n                <View style={styles.orderItemDetails}>\r\n                  <Text numberOfLines={2} style={styles.orderItemName}>\r\n                    {item.product.name || t('ui.checkout.productUnavailableItem')}\r\n                  </Text>\r\n                  {variant && <Text style={styles.orderItemMeta}>{variant.quantity} {variant.unit}</Text>}\r\n                  <Text style={styles.orderItemMeta}>\r\n                    {t('ui.checkout.qtyEach', { count: item.quantity, price: unitPrice.toFixed(2) })}\r\n                  </Text>\r\n                  {variant && hasVariantDiscount(variant) && <Text style={styles.orderItemMeta}><Text style={{ textDecorationLine: 'line-through' }}>{String.fromCharCode(0x20b9)}{variant.price.toFixed(2)}</Text> ({variantDiscountPercentage(variant)}% off)</Text>}\r\n                </View>\r\n                <Text style={styles.orderItemTotal}>₹{itemTotal.toFixed(2)}</Text>\r\n              </View>\r\n            );\r\n          })}\r\n        </View>\r\n      ) : (\r\n        <Text style={[styles.muted, styles.orderItemsEmpty]}>\r\n          {t('ui.checkout.noItems')}\r\n        </Text>\r\n      )}\r\n\r\n      <Row label={t('ui.checkout.subtotal')} value={`₹${subtotal.toFixed(2)}`} />\r\n\r\n      {discount > 0 ? (\r\n        <Row label={t('ui.checkout.discount')} value={`-₹${discount.toFixed(2)}`} />\r\n      ) : null}\r\n\r\n      <Row label={t('ui.checkout.shippingCost')} value={`₹${shipping.toFixed(2)}`} />\r\n\r\n      <View style={styles.total}>\r\n        <Text style={styles.totalLabel}>{t('ui.checkout.total')}</Text>\r\n        <Text style={styles.totalValue}>₹{total.toFixed(2)}</Text>\r\n      </View>\r\n    </View>\r\n  );\r\n}\r\n\r\nfunction Row({ label, value }: { label: string; value: string }) {\r\n  const styles = useStyles();\r\n  return (\r\n    <View style={styles.row}>\r\n      <Text style={styles.muted}>{label}</Text>\r\n      <Text style={styles.value}>{value}</Text>\r\n    </View>\r\n  );\r\n}\r\n\r\nfunction Button({\r\n  title,\r\n  onPress,\r\n  disabled = false,\r\n}: {\r\n  title: string;\r\n  onPress: () => void;\r\n  disabled?: boolean;\r\n}) {\r\n  const styles = useStyles();\r\n  return (\r\n    <Pressable\r\n      disabled={disabled}\r\n      onPress={onPress}\r\n      style={[styles.button, disabled && styles.buttonDisabled]}\r\n    >\r\n      <Text style={styles.buttonText}>{title}</Text>\r\n    </Pressable>\r\n  );\r\n}\r\n\r\nconst createStyles = (colors: ThemeColors, mode: 'light' | 'dark') =>\r\n  StyleSheet.create({\r\n    container: {\r\n      flex: 1,\r\n      backgroundColor: colors.background,\r\n    },\r\n\r\n    content: {\r\n      padding: 16,\r\n      paddingBottom: 100,\r\n    },\r\n\r\n    header: {\r\n      height: 56,\r\n      flexDirection: 'row',\r\n      alignItems: 'center',\r\n      paddingHorizontal: 16,\r\n      borderBottomWidth: 1,\r\n      border